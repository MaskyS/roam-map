{
  "name": "roam-map",
  "version": "0.1.0",
  "private": true,
  "description": "Compose Roam outlines into live inline maps",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "test": "node --test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "maplibre-gl": "5.24.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  }
}
